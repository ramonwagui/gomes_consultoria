{
  "name": "gestconv360",
  "version": "0.1.0",
  "private": true,
  "description": "API do modulo Instrumentos/Propostas do Gestconv360",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "check:quality": "npm run build && npm run web:build && npm run test:tickets-regression && npm run assistente:acceptance",
    "start": "node dist/server.js",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "seed:demo": "tsx src/scripts/seed-demo-instrumentos.ts",
    "backup:hourly": "tsx src/scripts/backup-run.ts hourly",
    "backup:daily": "tsx src/scripts/backup-run.ts daily",
    "backup:monthly": "tsx src/scripts/backup-run.ts monthly",
    "backup:purge-docs": "tsx src/scripts/backup-purge-docs.ts",
    "assistente:acceptance": "tsx src/scripts/assistente-acceptance-check.ts",
    "assistente:sync-pgvector": "tsx src/scripts/assistente-sync-pgvector.ts",
    "pgvector:bootstrap": "tsx src/scripts/assistente-bootstrap-pgvector.ts",
    "test:tickets-regression": "tsx src/scripts/tickets-regression-check.ts",
    "test:transferencias-especiais-financeiro": "tsx src/scripts/transferencias-especiais-financeiro-check.ts",
    "dev:restart": "tsx src/scripts/run-and-restart-dev-servers.ts",
    "prisma:generate": "prisma generate --schema ./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema ./prisma/schema.prisma --name init",
    "prisma:studio": "prisma studio --schema ./prisma/schema.prisma",
    "sync:especiais:realtime": "tsx src/scripts/run-sync-especiais-realtime.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.916.0",
    "@prisma/client": "^6.6.0",
    "@prisma/debug": "^7.7.0",
    "@prisma/engines-version": "^7.6.0-1.75cbdc1eb7150937890ad5465d861175c6624711",
    "@types/cookie-parser": "^1.4.10",
    "@types/multer": "^2.1.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.6.1",
    "docxtemplater": "^3.68.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "fflate": "^0.8.2",
    "googleapis": "^144.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "openai": "^6.33.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "pizzip": "^3.2.0",
    "playwright": "^1.59.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cheerio": "^0.22.35",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.13.13",
    "@types/pg": "^8.15.5",
    "prisma": "^6.6.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
